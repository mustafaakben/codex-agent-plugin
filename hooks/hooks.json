{
  "description": "Agent-Codex hooks for config detection and safe Codex delegation",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(mcp__codex-native__codex|mcp__codex-native__codex-reply)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-codex.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp__codex-native__codex|mcp__codex-native__codex-reply)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-codex.sh"
          }
        ]
      }
    ]
  }
}
